@import "colors.rasi"

* {
  font: "Iosevka 11";
  background-color: transparent;
  text-color: @fg;
}

window {
  location: center;
  width: 82%;
  background-color: @bg;
  border: 0;
  border-radius: 20px;
  padding: 20px;
}

mainbox { children: [ inputbar, listview ]; spacing: 16px; }

inputbar {
  children: [ prompt, entry ];
  background-color: @bg-alt;
  border-radius: 14px;
  padding: 12px 18px;
  spacing: 12px;
}
prompt { text-color: @accent; }
entry { placeholder: "filter"; placeholder-color: @dim; }

listview { columns: 4; lines: 3; spacing: 14px; scrollbar: false; }

element { orientation: vertical; padding: 10px; border-radius: 14px; spacing: 6px; text-color: @dim; }
element selected.normal { background-color: @bg-alt; text-color: @accent; }
element-icon { size: 11em; horizontal-align: 0.5; }
element-text { horizontal-align: 0.5; text-color: inherit; }
