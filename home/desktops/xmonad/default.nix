{ config, lib, pkgs, ... }:

let
  wallpaperSearch = pkgs.writeShellScriptBin "wallpaper-search" ''
    export PATH=${lib.makeBinPath (with pkgs; [ curl jq rofi feh imagemagick libnotify findutils coreutils gnugrep ])}:$PATH
    ${builtins.readFile ./wallpaper-search.sh}
  '';

  xtheme = pkgs.writeShellScriptBin "xtheme" ''
    export PATH=${lib.makeBinPath (with pkgs; [ procps dconf libnotify dunst trayer coreutils gnused ])}:$PATH
    export XMOBAR_TPL=${./xmobarrc.tpl}
    ${builtins.readFile ./xtheme.sh}
  '';
in
{
  home.packages = with pkgs; [
    xmobar rofi rofimoji xdotool xclip feh xss-lock i3lock picom libnotify
    xsetroot xset xrdb xmessage
    kdePackages.dolphin
    wallpaperSearch xtheme
    # "real DE" bits: tray, notifications, applets, automount, polkit prompts
    trayer dunst networkmanagerapplet blueman udiskie polkit_gnome dbus dconf
    gh
  ];

  home.sessionVariables.DEFAULT_WM = lib.mkDefault "xmonad";

  # Recompiled by xmonad itself at login. Drop the cached binary when the source changes.
  home.file.".xmonad/xmonad.hs" = {
    source = ./xmonad.hs;
    onChange = "rm -f $HOME/.xmonad/xmonad-x86_64-linux $HOME/.cache/xmonad/xmonad-x86_64-linux $HOME/.xmonad/xmonad.hi $HOME/.xmonad/xmonad.o";
  };
  xdg.configFile."picom/picom.conf".source = ./picom.conf;
  # colors.rasi is generated by `xtheme` (dark/light)
  xdg.configFile."rofi/launcher.rasi".source = ./rofi/launcher.rasi;
  xdg.configFile."rofi/gallery.rasi".source = ./rofi/gallery.rasi;

  home.file.".xinitrc" = {
    executable = true;
    text = ''
      #!/bin/sh
      [ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"
      dbus-update-activation-environment --systemd DISPLAY XAUTHORITY 2>/dev/null
      xsetroot -cursor_name left_ptr
      # last wallpaper picked with wallpaper-search (Alt+W), else a plain colour
      wp="$(cat "$HOME/.cache/wallpaper/current" 2>/dev/null)"
      if [ -n "$wp" ] && [ -f "$wp" ]; then
        feh --bg-fill "$wp"
      else
        xsetroot -solid '#11111b'
      fi
      # generate dark/light colours (rofi, dunst, bar, kitty) before anything uses them
      xtheme apply
      picom -b
      dunst &
      xtheme tray
      nm-applet &
      blueman-applet &
      udiskie --tray &
      ${pkgs.polkit_gnome}/libexec/polkit-gnome-authentication-agent-1 &
      command -v kdeconnect-indicator >/dev/null && kdeconnect-indicator &
      # screen blank after 10 min (5 s warning), DPMS off after 15 min
      xset s 600 5
      xset dpms 0 0 900
      xss-lock --transfer-sleep-lock -- i3lock -n -c 11111b &
      exec xmonad
    '';
  };
}
